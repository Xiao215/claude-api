# Copy to .env (in the folder you start claude-api from) and edit. Every setting
# is optional; real environment variables override this file.

# Where to listen. Keep 127.0.0.1 so only this computer can reach it.
PORT=8787
HOST=127.0.0.1

# Optional on localhost; REQUIRED if HOST is anything else. Clients send it as
# `Authorization: Bearer <key>` (OpenAI SDKs) or `x-api-key` (Anthropic SDKs).
# Generate one with: openssl rand -hex 24
# API_KEY=

# Model used when a client's model name doesn't map to one: haiku | sonnet | opus | fable
DEFAULT_MODEL=sonnet

# Your own model names, e.g. for a tool that only lets you pick OpenAI models.
# MODEL_ALIASES=gpt-4o-mini=haiku,gpt-4o=sonnet

# Claude Code tools it may use. Empty = chat only (no web, no files).
# TOOLS=WebSearch,WebFetch

# Thinking effort: low | medium | high | xhigh | max (empty = CLI default).
# Requests can override it (reasoning_effort / output_config.effort / effort).
# EFFORT=

# How many `claude` processes may run at once; extra requests wait in line.
MAX_CONCURRENT=2
TIMEOUT_SECONDS=300

# Browser origins allowed to call this (comma-separated). Empty = no web pages.
# ALLOWED_ORIGINS=http://localhost:5173

# Full path if `claude` isn't on PATH
# CLAUDE_CLI=/opt/homebrew/bin/claude
